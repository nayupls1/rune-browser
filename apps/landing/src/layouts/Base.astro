---
import "../styles/global.css";
import icon from "../../../browser/build/icon.svg?url";

interface Props {
  title?: string;
  description?: string;
  /** "light dark" follows the OS; "dark" for pages that are always dark. */
  scheme?: "light dark" | "dark";
}

const {
  title = "Rune Browser",
  description = "A calm desktop browser you change by asking, on Claude Code, Codex or OpenCode.",
  scheme = "light dark",
} = Astro.props;

// What the page may load: its own stylesheet, fonts and images, nothing else. No scripts at all, so an
// injected tag can't run. Only in the build: the dev server needs its own client script. Hosts that read
// public/_headers also get it as a header, with frame-ancestors (ignored in a meta tag).
const csp = [
  "default-src 'none'",
  "img-src 'self'",
  "style-src 'self'",
  "font-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={scheme} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={icon} type="image/svg+xml" />
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
  </head>
  <body>
    <slot />
  </body>
</html>
