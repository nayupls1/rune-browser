---
import * as stylex from "@stylexjs/stylex";
import Mark from "../components/Mark.astro";
import Base from "../layouts/Base.astro";
import { download, repo, version } from "../lib/site";
import { s } from "../styles/v3";

const claims = [
  {
    claim: "Calm.",
    gloss: "One slim bar, a sidebar that slides away, and nothing else asking for your attention.",
  },
  {
    claim: "Yours to change.",
    gloss:
      "Ask for any site to look or work differently and the change stays, on every visit. On Claude Code, Codex or OpenCode, with the login you already have.",
  },
  {
    claim: "Does the clicking.",
    gloss:
      "It searches, fills in forms and works through pages in your own tab, and asks before anything that pays, posts or deletes.",
  },
  {
    claim: "Learns as you go.",
    gloss:
      "Each site you visit teaches it how that site works, its requests and their shapes but never your data, so your agent starts out knowing your sites.",
  },
];
---

<Base>
  <div {...stylex.attrs(s.page)}>
    <header {...stylex.attrs(s.header)}>
      <span {...stylex.attrs(s.brand)}><Mark size={14} label="" /> Rune Browser</span>
      <a {...stylex.attrs(s.headerLink)} href={download}>Download</a>
    </header>
    <main>
      <h1 class="sr-only">Rune Browser</h1>
      <ul {...stylex.attrs(s.list)}>
        {
          claims.map(({ claim, gloss }) => (
            <li {...stylex.attrs(s.item)}>
              <h2 {...stylex.attrs(s.claim)}>{claim}</h2>
              <p {...stylex.attrs(s.gloss)}>{gloss}</p>
            </li>
          ))
        }
      </ul>
      <section {...stylex.attrs(s.close)}>
        <p {...stylex.attrs(s.closeText)}>
          For macOS, Windows and Linux. Free and open source, version {version} on <a
            {...stylex.attrs(s.link)}
            href={repo}>GitHub</a
          >.
        </p>
        <a {...stylex.attrs(s.button)} href={download}>Download Rune Browser</a>
      </section>
    </main>
  </div>
</Base>
