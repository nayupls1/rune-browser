---
// 5, "Close-ups": two pieces of the browser's own UI, sharp, on its sidebar color.
import { Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import changesMenu from "../assets/screens/changes-menu.png";
import composer from "../assets/screens/composer.png";
import Home from "../layouts/Home.astro";
import { s } from "../styles/letter";
import { five } from "../styles/home";
---

<Home>
  <figure>
    <div {...stylex.attrs(five.panel)}>
      <Image
        {...stylex.attrs(five.piece, five.composer)}
        src={composer}
        widths={[356, 712]}
        sizes="356px"
        alt="The agent's composer with “Hide everything except the recipe, and make the ingredients bigger” typed in."
        loading="eager"
      />
      <Image
        {...stylex.attrs(five.piece, five.menu)}
        src={changesMenu}
        widths={[360, 720]}
        sizes="360px"
        alt="The menu of changes on this page: hide the ads, hide the life story, hide the newsletter pop-up, larger ingredients, each with a switch."
        loading="eager"
      />
    </div>
    <figcaption {...stylex.attrs(s.caption)}>
      What you ask for, and what stays: every change is listed on the page it applies to, with a switch.
    </figcaption>
  </figure>
</Home>
