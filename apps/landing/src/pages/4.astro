---
// 4, "Sketch": the browser drawn in outline (no screenshot), with a change asked for in its sidebar.
import * as stylex from "@stylexjs/stylex";
import Home from "../layouts/Home.astro";
import { four as d } from "../styles/home";
---

<Home>
  <figure
    {...stylex.attrs(d.window)}
    aria-label="A drawing of Rune Browser on a recipe site: the ads and the life story are hidden, after a request in the agent's sidebar."
  >
    <div {...stylex.attrs(d.bar)} aria-hidden="true">
      <div {...stylex.attrs(d.dots)}>
        <span {...stylex.attrs(d.dot)}></span><span {...stylex.attrs(d.dot)}></span><span {...stylex.attrs(d.dot)}></span>
      </div>
      <div {...stylex.attrs(d.address)}><span {...stylex.attrs(d.host)}>slowcooked.blog</span>/recipes/tomato-soup</div>
    </div>
    <div {...stylex.attrs(d.body)} aria-hidden="true">
      <div {...stylex.attrs(d.page)}>
        <div {...stylex.attrs(d.hidden)}>Hidden: ads</div>
        <p {...stylex.attrs(d.title)}>Weeknight Tomato Soup</p>
        <div {...stylex.attrs(d.hidden)}>Hidden: the life story</div>
        <div {...stylex.attrs(d.card)}>
          <span {...stylex.attrs(d.cardHead)}>Ingredients</span>
          <div {...stylex.attrs(d.rows)}>
            <div {...stylex.attrs(d.row, d.w60)}></div>
            <div {...stylex.attrs(d.row, d.w45)}></div>
            <div {...stylex.attrs(d.row, d.w70)}></div>
            <div {...stylex.attrs(d.row, d.w45)}></div>
          </div>
          <span {...stylex.attrs(d.cardHead)}>Steps</span>
          <div {...stylex.attrs(d.rows)}>
            <div {...stylex.attrs(d.row, d.w85)}></div>
            <div {...stylex.attrs(d.row, d.w70)}></div>
          </div>
        </div>
      </div>
      <div {...stylex.attrs(d.side)}>
        <p {...stylex.attrs(d.ask)}>Hide everything except the recipe</p>
        <p {...stylex.attrs(d.reply)}>Done. These apply on every visit to slowcooked.blog.</p>
        <p {...stylex.attrs(d.saved)}><span {...stylex.attrs(d.savedDot)}></span> 3 changes saved</p>
        <div {...stylex.attrs(d.composer)}>
          <span {...stylex.attrs(d.placeholder)}>Ask about or change this page</span>
          <div {...stylex.attrs(d.composerRow)}>
            <span {...stylex.attrs(d.chip)}>Claude Code</span>
            <span {...stylex.attrs(d.send)}></span>
          </div>
        </div>
      </div>
    </div>
  </figure>
</Home>
