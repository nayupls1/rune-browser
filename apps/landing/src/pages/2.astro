---
// 2, "Before and after": the cluttered page with the request, and the same page afterwards.
import { Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import ask from "../assets/screens/ask.png";
import changes from "../assets/screens/changes.png";
import Home from "../layouts/Home.astro";
import { s } from "../styles/letter";
import { two } from "../styles/home";
---

<Home>
  <figure>
    <div {...stylex.attrs(two.stack)}>
      <Image
        {...stylex.attrs(s.shot, two.before)}
        src={ask}
        widths={[800, 1280, 1600]}
        sizes="(min-width: 1080px) 40vw, 82vw"
        alt="A recipe page full of ads, a long story and a newsletter pop-up, with “Hide everything except the recipe, and make the ingredients bigger” typed into the agent's sidebar."
        loading="eager"
      />
      <Image
        {...stylex.attrs(s.shot, two.after)}
        src={changes}
        widths={[800, 1280]}
        sizes="(min-width: 1080px) 40vw, 82vw"
        alt="The same page afterwards: only the recipe is left, and the menu of changes lists each one with a switch."
        loading="eager"
      />
    </div>
    <figcaption {...stylex.attrs(s.caption)}>
      Ask once on a cluttered page. The changes stay on every visit, each with its own switch.
    </figcaption>
  </figure>
</Home>
