---
// 3, "Tour": a screenshot for each thing the text says, with a line under each.
import { Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import apiMap from "../assets/screens/api-map.png";
import ask from "../assets/screens/ask.png";
import changes from "../assets/screens/changes.png";
import Home from "../layouts/Home.astro";
import { s } from "../styles/letter";
import { three } from "../styles/home";

const shots = [
  {
    src: ask,
    caption: "Ask on the page you're on, in plain words.",
    alt: "A cluttered recipe page with a request typed into the agent's sidebar.",
  },
  {
    src: changes,
    caption: "Each change is listed with a switch, and stays on every visit.",
    alt: "The recipe page with its clutter hidden and the menu of changes open.",
  },
  {
    src: apiMap,
    caption: "What it has learned about a site: its endpoints and their shapes, never your data.",
    alt: "Rune's API map for the recipe site: five endpoints, one opened to show the shape of what it returns.",
  },
];
---

<Home sticky={false}>
  <div {...stylex.attrs(three.list)}>
    {
      shots.map(({ src, caption, alt }) => (
        <figure>
          <Image
            {...stylex.attrs(s.shot)}
            src={src}
            widths={[800, 1280, 1600]}
            sizes="(min-width: 1080px) 50vw, 100vw"
            alt={alt}
          />
          <figcaption {...stylex.attrs(s.caption)}>{caption}</figcaption>
        </figure>
      ))
    }
  </div>
</Home>
