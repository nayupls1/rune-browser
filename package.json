{
  "name": "rune-browser",
  "productName": "Rune Browser",
  "desktopName": "rune-browser.desktop",
  "version": "0.1.0",
  "description": "A desktop browser where coding agents build your own small apps, on your own Claude, Codex or OpenCode login",
  "license": "MIT",
  "author": "nayupls1",
  "homepage": "https://github.com/nayupls1/rune-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/nayupls1/rune-browser.git"
  },
  "bugs": "https://github.com/nayupls1/rune-browser/issues",
  "packageManager": "bun@1.4.4",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "start": "bun scripts/start.ts",
    "package": "bun run build && electron-builder --publish never",
    "release": "bun scripts/release.ts",
    "server": "bun --watch src/server/index.ts",
    "typecheck": "bun check --no-script",
    "test": "bun scripts/test.ts",
    "e2e": "bun scripts/e2e.ts",
    "check": "bun fmt --check && bun run typecheck && bun run test && bun run build && bun run e2e"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@electron/fuses": "1.8.0",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/bun": "^1.4.4",
    "effect": "4.0.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.11",
    "lucide-solid": "^1.57.0",
    "lucide-static": "^1.57.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "unplugin": "^2.3.11",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
