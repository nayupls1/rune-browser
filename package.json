{
  "name": "rune",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/browser dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "build": "turbo run build",
    "start": "bun run --cwd apps/browser start",
    "package": "bun run --cwd apps/browser package",
    "release": "bun run --cwd apps/browser release",
    "server": "bun run --cwd apps/browser server",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "bun run --cwd apps/browser e2e",
    "check": "bun fmt --check && turbo run typecheck test build && bun run e2e"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
